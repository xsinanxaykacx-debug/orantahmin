{
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/iddaa-superlig",
      "destination": "/api/iddaa?resource=superlig"
    },
    {
      "source": "/api/iddaa-superlig-team",
      "destination": "/api/iddaa?resource=team"
    },
    {
      "source": "/api/iddaa-lineups",
      "destination": "/api/iddaa?resource=lineups"
    },
    {
      "source": "/api/iddaa-markets",
      "destination": "/api/iddaa?resource=markets"
    }
  ],
  "functions": {
    "api/iddaa.ts": {
      "includeFiles": [
        "scripts/iddaa/**/*.ts",
        "lib/iddaaGismo.ts"
      ]
    }
  }
}
